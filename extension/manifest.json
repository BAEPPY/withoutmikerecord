{
  "manifest_version": 3,
  "name": "Without Mike · 탭 소리 녹음",
  "version": "1.0.0",
  "description": "마이크 없이 현재 탭의 소리만 녹음하고 MP4 오디오 파일로 저장하세요.",
  "minimum_chrome_version": "128",
  "permissions": ["activeTab", "tabCapture", "offscreen", "downloads"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "탭 소리 녹음",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
